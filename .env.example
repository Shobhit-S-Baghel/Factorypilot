# ==========================================
# FactoryPilot Environment Variables Configuration
# Copy this file to .env before starting the services
# ==========================================

# Environment Mode: development | staging | production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://frontend:3000"]
SECRET_KEY=factorypilot-insecure-dev-secret-change-in-production

# ------------------------------------------
# Frontend Service Configuration (Next.js)
# ------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------
# Vector Store Configuration (ChromaDB)
# ------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_HOST_PORT=8001
CHROMA_COLLECTION_NAME=factory_manuals
CHROMA_PERSIST_DIRECTORY=/chroma/chroma
CHROMA_AUTH_CREDENTIALS=
CHROMA_ALLOW_RESET=true

# ------------------------------------------
# Industrial Telemetry & Polling Settings
# ------------------------------------------
TELEMETRY_REFRESH_INTERVAL_MS=2500
ANOMALY_DETECTION_SENSITIVITY=HIGH
ALERT_WEBHOOK_URL=
